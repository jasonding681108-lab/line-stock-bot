# 從 LINE Developers Console > 你的 Channel > Messaging API 取得
LINE_CHANNEL_ACCESS_TOKEN=paste_your_channel_access_token_here
LINE_CHANNEL_SECRET=paste_your_channel_secret_here

# FinMind token（可選）— 免費帳號可在 https://finmindtrade.com 申請
# 不填也可執行，但法人資料每日有請求次數限制
FINMIND_TOKEN=

# 本機測試 port（選填，預設 5000）
PORT=5000
